# Copy to .env and fill in. .env is gitignored and never committed.
OPENROUTER_API_KEY=
RUNPOD_API_KEY=

# S3 access to the network volume (scripts/volume_s3.py). Separate credentials from
# RUNPOD_API_KEY — created in the RunPod console under Settings -> S3 API Keys. With
# these, the volume can be read without renting a pod.
RUNPOD_S3_ACCESS_KEY=
RUNPOD_S3_SECRET_KEY=
